# Copy to .env.local (or the deployment environment). Never commit real keys.
# This application always uses BNB Smart Chain mainnet, chain ID 56.

# Wallet login (Privy). Configure the deployed origin in the Privy dashboard.
NEXT_PUBLIC_PRIVY_APP_ID=
# PRIVY_APP_SECRET is not needed: wallet connection uses the public App ID only.

# Required server-only Binance Web3 API credentials for token discovery,
# prices, quotes, approvals, transaction checks, and execution.
# Missing credentials show unavailable data; no demo prices or trades are used.
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=
# Required for Vercel deployment: stable server-only order-recovery secret.
# Generate once with node:crypto randomBytes(32).toString('hex'); retain privately.
# Local trading falls back to the Binance secret if absent.
STOCKVA_TRADING_SESSION_SECRET=

# Optional BSC mainnet RPC endpoints. Must resolve chain ID 56.
BSC_MAINNET_RPC_URL=https://bsc-dataseed.binance.org
NEXT_PUBLIC_BSC_RPC_URL=https://bsc-dataseed.binance.org

# Optional AI portfolio advisor. No key means analysis is unavailable.
# The advisor cannot move money or execute/schedule trades.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
MUSESPARK_API_KEY=
MUSESPARK_BASE_URL=https://api.musespark.ai/v1
MUSESPARK_MODEL=muse-spark-1.3

# Optional identifying application name and contact for SEC EDGAR fair access.
SEC_USER_AGENT=
