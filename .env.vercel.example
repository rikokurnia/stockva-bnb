# Vercel > stockva-bnb > Settings > Environment Variables.
# Replace every REPLACE_* value before importing. Do not upload a real env file to Git.
# Enable Production; enable Preview only when you also configure that Privy origin.

# REQUIRED PUBLIC VALUE: Privy dashboard > your app > App ID.
# Browser-visible. Add your deployed HTTPS domain to Privy's allowed origins.
NEXT_PUBLIC_PRIVY_APP_ID=REPLACE_WITH_YOUR_PRIVY_APP_ID

# REQUIRED SERVER-ONLY VALUES: your Binance Web3 API credentials.
# Mark these as Sensitive in Vercel. Never use a NEXT_PUBLIC_ prefix.
BINANCE_WEB3_API_KEY=REPLACE_WITH_YOUR_BINANCE_WEB3_API_KEY
BINANCE_WEB3_API_SECRET=REPLACE_WITH_YOUR_BINANCE_WEB3_API_SECRET

# REQUIRED SERVER-ONLY VALUE: generate once, save privately, retain across redeploys.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Use the resulting 64-character string. Mark Sensitive in Vercel.
STOCKVA_TRADING_SESSION_SECRET=REPLACE_WITH_A_RANDOM_64_CHARACTER_HEX_SECRET

# Optional RPC overrides. These defaults work without a separate RPC key.
# Both must serve BNB Smart Chain mainnet (56). Browser RPC URLs are public.
BSC_MAINNET_RPC_URL=https://bsc-dataseed.binance.org
NEXT_PUBLIC_BSC_RPC_URL=https://bsc-dataseed.binance.org

# Optional: enable Cokoo advisor with one provider (no key = unavailable advisor).
# Add these separately only when needed; use a model supported by your account.
# DEEPSEEK_API_KEY=REPLACE_WITH_YOUR_DEEPSEEK_API_KEY
# DEEPSEEK_MODEL=deepseek-chat
# GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY
# GEMINI_MODEL=REPLACE_WITH_YOUR_SUPPORTED_GEMINI_MODEL
# MUSESPARK_API_KEY=REPLACE_WITH_YOUR_MUSESPARK_API_KEY
# MUSESPARK_MODEL=REPLACE_WITH_YOUR_SUPPORTED_MUSESPARK_MODEL
# MUSESPARK_BASE_URL=https://api.musespark.ai/v1

# Optional SEC financial research identification: your real contact address.
# SEC_USER_AGENT=Stockva research your-email@example.com

# Not needed: PRIVY_APP_SECRET, PRIVY_APP_ID, a deployer private key,
# NEXT_PUBLIC_VAULT_ADDRESS, a chain ID variable, or a Vercel access token.
# Do not set STOCKCITY_NEXT_DIST_DIR on Vercel. Vercel uses the normal .next output.
